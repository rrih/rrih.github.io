{
  "name": "pokemon-atlas",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3333",
    "build": "bun scripts/generate-locales.ts && tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 3333",
    "test": "bun test test",
    "lint": "biome check src test scripts/*.ts",
    "format": "biome check --write src test scripts/*.ts",
    "dev-check": "bun run lint && bun test && bun run build",
    "prepare": "husky"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "lucide-react": "^0.542.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/extensions": "^4.5.0",
    "@gltf-transform/functions": "^4.5.0",
    "@playwright/test": "^1.55.0",
    "@types/bun": "^1.2.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.0",
    "draco3dgltf": "^1.5.7",
    "husky": "^9.1.7",
    "sharp": "^0.34.3",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vite-plugin-pwa": "^1.0.3"
  },
  "overrides": {
    "esbuild": "0.28.0"
  }
}
